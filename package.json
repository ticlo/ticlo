{
  "name": "ticlo",
  "version": "0.0.12",
  "description": "ticlo runtime",
  "repository": {
    "type": "git",
    "url": "https://github.com/ticlo/ticlo.git"
  },
  "author": {
    "name": "Rick Zhou",
    "email": "rinick@gmail.com"
  },
  "license": "MPL-2.0",
  "type": "module",
  "devDependencies": {
    "@ant-design/static-style-extract": "^2.1.0",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@babel/register": "^8.0.1",
    "@babel/standalone": "^8.0.4",
    "@hono/node-server": "^2.1.1",
    "@hono/node-ws": "^1.3.1",
    "@rc-component/picker": "^1.13.0",
    "@ticlo/core": "workspace:*",
    "@ticlo/editor": "workspace:*",
    "@ticlo/html": "workspace:*",
    "@ticlo/node": "workspace:*",
    "@ticlo/react": "workspace:*",
    "@ticlo/test": "workspace:*",
    "@ticlo/web-server": "workspace:*",
    "@types/babel__preset-env": "^7.10.0",
    "@types/babel__standalone": "^7.1.9",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.5.0",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/serve-static": "^2.2.0",
    "@types/shelljs": "^0.10.0",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "5.0.0",
    "antd": "6.6.3",
    "arrow-code": "^0.3.3",
    "axios": "1.20.0",
    "base64-js": "^1.5.1",
    "c8": "^12.0.0",
    "chalk": "^6.0.0",
    "cross-env": "^10.1.0",
    "diff-sequences": "^29.6.3",
    "glob": "^13.0.6",
    "hono": "^4.13.7",
    "less": "^4.9.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "pretty-format": "^30.5.1",
    "rc-dock": "^4.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shelljs": "^0.10.0",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.13",
    "vite": "^8.2.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "vite-dev": "vite",
    "vite-build": "vite build",
    "build-pages": "mkdir -p css i18n && pnpm run build-i18n && pnpm run build-less && pnpm run build-antd-style && pnpm run build-icons && pnpm run vite-build --base=/ticlo/",
    "test-c8-strict": "pnpm run test-coverage && node -e \"require('fs').copyFileSync('coverage/node/lcov.info', 'coverage/c8-strict.lcov')\"",
    "test-c8": "pnpm run test-coverage",
    "build-less": "lessc --js packages/editor/style/index.less css/editor.css",
    "build-antd-style": "tsx tool/extractAntdStyle.tsx",
    "build-icons": "tsx tool/build-icons",
    "build-i18n": "tsx tool/merge-lng",
    "build-i18n-pre-collect-en": "tsx tool/collect-editor-en-locale.ts",
    "build-package": "tsx tool/build-package.ts",
    "build-cleanup": "tsx tool/cleanup-build-output.ts",
    "test": "cross-env NODE_ENV=TEST vitest run",
    "test-coverage": "cross-env NODE_ENV=TEST vitest run --coverage",
    "test-browser": "cross-env NODE_ENV=TEST vitest run -c vitest.web.config.mts",
    "test-browser-ui": "cross-env NODE_ENV=TEST HEADLESS=false vitest -c vitest.web.config.mts --standalone",
    "test-browser-coverage": "cross-env NODE_ENV=TEST vitest run -c vitest.web.config.mts --coverage",
    "ticlo-server": "tsx app/server/ticlo-server.ts",
    "server": "tsx app/server/ticlo-server.ts",
    "ticlo-test": "tsx app/test/test-server --serve --run --quitOnFinish",
    "ticlo-test-server": "tsx app/test/test-server --serve --run",
    "ticlo-test-c8": "c8 tsx ./app/test/test-server.ts --run --quitOnFinish && c8 report --reporter=text-lcov > coverage/nyc-ticlo.lcov",
    "oxfmt-check": "oxfmt --check \"{packages,tool,app}/**/*.{ts,tsx,less}\"",
    "oxfmt-write": "oxfmt --write \"{packages,tool,app}/**/*.{ts,tsx,less}\"",
    "oxlint": "oxlint .",
    "oxlint-fix": "oxlint . --fix"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.11.0"
  }
}
