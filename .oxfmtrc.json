{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "printWidth": 120,
  "semi": true,
  "singleQuote": true,
  "bracketSpacing": false,
  "arrowParens": "always",
  "quoteProps": "consistent",
  "trailingComma": "es5",
  "sortPackageJson": false,
  "ignorePatterns": ["/packages/**/3rd_party"]
}
